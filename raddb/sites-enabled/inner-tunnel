# Inside the TTLS tunnel: forward the inner PAP request to the central node (which checks it with Entra ID).
# No listen section: it is only reached through the eap module, so it opens no port on the host.
server inner-tunnel {

	authorize {
		filter_username
		if (!&User-Password) {
			reject
		}
		update control {
			&Proxy-To-Realm := "ENTRA"
		}
	}

	authenticate {
	}

	post-auth {
		# One line for an accepted login (the central server's Access-Accept to the proxied inner request
		# comes back here), with the real inner user.
		login_ok
		Post-Auth-Type REJECT {
			# An inner request rejected locally (for example without a password). A rejection by a central
			# server is logged in the outer server's post-proxy instead.
			login_incorrect
			attr_filter.access_reject
		}
	}

	pre-proxy {
	}

	post-proxy {
	}
}
