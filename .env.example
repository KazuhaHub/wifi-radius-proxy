# Copy to .env next to compose.yaml and fill in. Never commit the real file.
# All 8 variables are required; the container validates every one at start and exits with a
# message naming each bad item. The addresses below are documentation examples only.
#
# Secrets must not contain: " \ $ { } # or a newline. They are special in FreeRADIUS
# configuration or in .env files. Generate them with: openssl rand -hex 16

# A short name for this site, used in logs. 1-32 characters from a-z, 0-9 and '-'.
SITE_NAME=example-site

# The LAN addresses the APs / AC send RADIUS from: one or more IPv4 addresses or CIDRs,
# comma-separated, no spaces. Each becomes one client (site-lan-1, site-lan-2, ...).
# Prefixes shorter than /8, 0.x addresses and loopback are refused.
AP_SUBNETS=192.168.10.0/24,192.168.20.0/24

# The shared secret entered in the APs / AC. One secret for all of the subnets above.
AP_RADIUS_SECRET=

# The central RADIUS servers as IPv4:port, comma-separated, no spaces, in fail-over order:
# the first is the primary, the others are tried only when the ones before it do not answer.
CENTRAL_SERVERS=203.0.113.10:1812,203.0.113.11:1812

# Shared secret between the sites and the central servers.
CENTRAL_SECRET=

# The central certificate service: http://IPv4:port, plain http, no path.
CERT_SYNC_URL=http://203.0.113.10:8080

# This site's own account for the certificate service.
CERT_SYNC_USER=
CERT_SYNC_PASSWORD=

# Not part of the 8. Optional knobs for tests and tuning; leave them out in normal use.
# They have generic defaults (shown). The CA fingerprint the certificate set must carry is not a
# setting: it is built into the image (CA_SHA256 in the Dockerfile).
# CERT_SYNC_INTERVAL=21600
# LISTEN_PORT=1812
